{
  "name": "entropy-flame",
  "version": "0.1.0",
  "private": true,
  "description": "Entropy: a fire-safety atlas of microgravity combustion research (NASA Space Apps 2026, Flame in Freefall)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "build": "vite build",
    "dev": "vite",
    "start": "node --import tsx src/api/server.node.ts",
    "api": "node --env-file=.env --import tsx src/api/server.node.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "three": "^0.187.0",
    "tsx": "^4.23.15"
  },
  "license": "MIT"
}
